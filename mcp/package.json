{
    "name": "safe-mind-mcp",
    "version": "0.1.0",
    "description": "MCP server for Safe Mind - lets AI assistants (Claude, ChatGPT, Gemini, Cursor and any MCP client) create and manage psychological risk assessments (Gefährdungsbeurteilung psychischer Belastung).",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "safe-mind",
        "gefährdungsbeurteilung",
        "psychische-belastung",
        "gbu-psyche",
        "arbeitsschutz",
        "employee-survey"
    ],
    "homepage": "https://www.safe-mind.de/developers",
    "license": "MIT",
    "type": "module",
    "bin": {
        "safe-mind-mcp": "./lib/index.js"
    },
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        }
    },
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build:lib": "tsc --project tsconfig.esm.json",
        "check:types": "tsc --noEmit",
        "test": "vitest run"
    },
    "files": [
        "lib",
        "README.md"
    ],
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.17.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "typescript": "^5.6.0",
        "vitest": "^3.2.4",
        "@types/node": "^22.0.0"
    }
}
